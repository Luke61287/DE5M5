import unittest
import pandas as pd


class TestLibraryBooksCleaning(unittest.TestCase):

    @classmethod
    def setUpClass(cls):

        cls.books_df = pd.read_csv("data/03_Library Systembook.csv")
        cls.customers_df = pd.read_csv("data/03_Library SystemCustomers.csv")

        cls.book_dq_before = {

            "blank_rows":
                cls.books_df.isna().all(axis=1).sum(),
        
            "missing_books":
                cls.books_df["Books"].isna().sum(),
        
            "missing_customer_ids":
                cls.books_df["Customer ID"].isna().sum(),
        
            "duplicate_records":
                cls.books_df.duplicated(
                    subset=[
                        "Books",
                        "Book checkout",
                        "Book Returned",
                        "Customer ID"
                    ]
                ).sum(),
        
            "date_quotes":
                (
                    cls.books_df["Book checkout"]
                    .astype(str)
                    .str.contains('"')
                    .sum()
                    +
                    cls.books_df["Book Returned"]
                    .astype(str)
                    .str.contains('"')
                    .sum()
                ),
        
            "leading_trailing_spaces":
                (
                    cls.books_df["Days allowed to borrow"]
                    .astype(str)
                    .ne(
                        cls.books_df[
                            "Days allowed to borrow"
                        ].astype(str).str.strip()
                    )
                    .sum()
                )
        }

        cls.customer_dq_before = {

            "blank_rows":
                cls.customers_df.isna().all(axis=1).sum(),
        
            "missing_customer_ids":
                cls.customers_df["Customer ID"].isna().sum(),
        
            "missing_customer_names":
                cls.customers_df["Customer Name"].isna().sum(),
        
            "duplicate_customer_ids":
                cls.customers_df.duplicated(
                    subset=["Customer ID"]
                ).sum(),
        
            "names_with_whitespace":
                (
                    cls.customers_df["Customer Name"]
                    .fillna("")
                    .ne(
                        cls.customers_df[
                            "Customer Name"
                        ].fillna("").str.strip()
                    )
                    .sum()
                )
        }

        # Reproduce notebook cleaning logic

        cls.books_df = cls.books_df.dropna(how="all")

        date_columns = ["Book checkout", "Book Returned"]

        for col in date_columns:
            cls.books_df[col] = (
                cls.books_df[col]
                .astype(str)
                .str.replace('"', '', regex=False)
            )

        cls.books_df["Days allowed to borrow"] = (
            cls.books_df["Days allowed to borrow"]
            .astype(str)
            .str.strip()
        )

        cls.books_df["Book checkout"] = pd.to_datetime(
            cls.books_df["Book checkout"],
            dayfirst=True,
            errors="coerce"
        )

        cls.books_df["Book Returned"] = pd.to_datetime(
            cls.books_df["Book Returned"],
            dayfirst=True,
            errors="coerce"
        )

        cls.books_df["Book checkout"] = (
            cls.books_df["Book checkout"]
            .apply(
                lambda x:
                x.replace(year=2023)
                if pd.notnull(x) and x.year > 2026
                else x
            )
        )

        cls.books_df = cls.books_df.drop_duplicates(
            subset=[
                "Books",
                "Book checkout",
                "Book Returned",
                "Customer ID"
            ]
        )

        cls.books_df["Books"] = (
            cls.books_df["Books"]
            .fillna("Unknown")
        )

        cls.books_df["Customer ID"] = (
            cls.books_df["Customer ID"]
            .fillna(-1)
        )

        cls.books_df["Customer ID"] = (
            pd.to_numeric(
                cls.books_df["Customer ID"],
                errors="coerce"
            )
            .astype("int64")
        )

        cls.books_df["Books"] = (
            cls.books_df["Books"]
            .str.strip()
            .str.title()
        )

        cls.books_df["Borrow_Days"] = (
            cls.books_df["Book Returned"]
            - cls.books_df["Book checkout"]
        ).dt.days

        # Additional DQ metrics
    
        cls.invalid_checkout_dates = (
            cls.books_df["Book checkout"]
            .isna()
            .sum()
        )
        
        cls.future_year_records = (
            cls.books_df["Book checkout"]
            .dropna()
            .dt.year
            .gt(2026)
            .sum()
        )
        
        cls.returned_before_checkout = len(
            cls.books_df[
                cls.books_df["Book Returned"]
                <
                cls.books_df["Book checkout"]
            ]
        )
        
        cls.borrow_period_violations = len(
            cls.books_df[
                cls.books_df["Borrow_Days"] > 14
            ]
        )
        
        cls.negative_borrow_days = len(
            cls.books_df[
                cls.books_df["Borrow_Days"] < 0
            ]
        )
        
        cls.unknown_books = (
            cls.books_df["Books"]
            .eq("Unknown")
            .sum()
        )
        
        cls.replaced_customer_ids = (
            cls.books_df["Customer ID"]
            .eq(-1)
            .sum()
        )

        # Customer dataset cleaning

        cls.customers_df = cls.customers_df.dropna(how="all")

        cls.customers_df["Customer Name"] = (
            cls.customers_df["Customer Name"]
            .str.strip()
            .str.title()
        )

        cls.customers_df = cls.customers_df[
            cls.customers_df["Customer ID"].notna()
        ]

        cls.customers_df["Customer ID"] = (
            pd.to_numeric(
                cls.customers_df["Customer ID"],
                errors="coerce"
            )
            .astype("int64")
        )

        cls.book_dq_after = {

            "blank_rows":
                cls.books_df.isna().all(axis=1).sum(),
        
            "missing_books":
                cls.books_df["Books"].isna().sum(),
        
            "missing_customer_ids":
                cls.books_df["Customer ID"].isna().sum(),
        
            "duplicate_records":
                cls.books_df.duplicated(
                    subset=[
                        "Books",
                        "Book checkout",
                        "Book Returned",
                        "Customer ID"
                    ]
                ).sum(),
    
            "date_quotes":
                (
                    cls.books_df["Book checkout"]
                    .astype(str)
                    .str.contains('"')
                    .sum()
                    +
                    cls.books_df["Book Returned"]
                    .astype(str)
                    .str.contains('"')
                    .sum()
                ),
        
            "leading_trailing_spaces":
                (
                    cls.books_df["Days allowed to borrow"]
                    .astype(str)
                    .ne(
                        cls.books_df[
                            "Days allowed to borrow"
                        ].astype(str).str.strip()
                    )
                    .sum()
                )
        }

        cls.customer_dq_after = {
            cls.standardised_customer_names = len(
                cls.customers_df[
                    cls.customers_df["Customer Name"]
                    ==
                    cls.customers_df["Customer Name"].str.title()
                ]
            )
            
            cls.integer_customer_ids = (
                pd.api.types.is_integer_dtype(
                    cls.customers_df["Customer ID"]
                )
            )

            "blank_rows":
                cls.customers_df.isna().all(axis=1).sum(),
        
            "missing_customer_ids":
                cls.customers_df["Customer ID"].isna().sum(),
        
            "missing_customer_names":
                cls.customers_df["Customer Name"].isna().sum(),
        
            "duplicate_customer_ids":
                cls.customers_df.duplicated(
                    subset=["Customer ID"]
                ).sum(),
        
            "names_with_whitespace":
                (
                    cls.customers_df["Customer Name"]
                    .fillna("")
                    .ne(
                        cls.customers_df[
                            "Customer Name"
                        ].fillna("").str.strip()
                    )
                    .sum()
                )
        }

    # -----------------------------------------
    # BOOKS TESTS
    # -----------------------------------------

    def test_no_completely_blank_rows(self):

        self.assertEqual(
            self.books_df.isna().all(axis=1).sum(),
            0
        )

    def test_quotes_removed_from_dates(self):

        found_quote = (
            self.books_df
            .astype(str)
            [["Book checkout", "Book Returned"]]
            .apply(lambda x: x.str.contains('"'))
            .any()
            .any()
        )

        self.assertFalse(found_quote)

    def test_dates_are_datetime(self):

        self.assertTrue(
            pd.api.types.is_datetime64_any_dtype(
                self.books_df["Book checkout"]
            )
        )

        self.assertTrue(
            pd.api.types.is_datetime64_any_dtype(
                self.books_df["Book Returned"]
            )
        )

    def test_future_year_typo_fixed(self):

        future_records = self.books_df[
            self.books_df["Book checkout"].dt.year > 2026
        ]

        self.assertEqual(len(future_records), 0)

    def test_duplicate_records_removed(self):

        duplicates = self.books_df.duplicated(
            subset=[
                "Books",
                "Book checkout",
                "Book Returned",
                "Customer ID"
            ]
        ).sum()

        self.assertEqual(duplicates, 0)

    def test_missing_book_names_handled(self):

        missing_books = self.books_df["Books"].isna().sum()

        self.assertEqual(missing_books, 0)

    def test_unknown_book_exists(self):

        self.assertIn(
            "Unknown",
            self.books_df["Books"].values
        )

    def test_customer_ids_are_integers(self):

        self.assertTrue(
            pd.api.types.is_integer_dtype(
                self.books_df["Customer ID"]
            )
        )

    def test_missing_customer_id_replaced(self):

        self.assertIn(
            -1,
            self.books_df["Customer ID"].values
        )

    def test_invalid_checkout_date_detected(self):

        invalid_dates = (
            self.books_df["Book checkout"]
            .isna()
            .sum()
        )

        self.assertGreaterEqual(invalid_dates, 1)

    def test_records_returned_before_checkout_found(self):

        bad_dates = self.books_df[
            self.books_df["Book Returned"]
            < self.books_df["Book checkout"]
        ]

        self.assertGreater(len(bad_dates), 0)

    def test_borrow_period_violations_found(self):

        violations = self.books_df[
            self.books_df["Borrow_Days"] > 14
        ]

        self.assertGreater(len(violations), 0)

    # -----------------------------------------
    # CUSTOMER TESTS
    # -----------------------------------------

    def test_customer_table_has_no_blank_rows(self):

        self.assertEqual(
            self.customers_df.isna().all(axis=1).sum(),
            0
        )

    def test_customer_id_has_no_nulls(self):

        self.assertEqual(
            self.customers_df["Customer ID"].isna().sum(),
            0
        )

    def test_customer_ids_are_integers(self):

        self.assertTrue(
            pd.api.types.is_integer_dtype(
                self.customers_df["Customer ID"]
            )
        )

    def test_customer_names_trimmed(self):

        whitespace_found = (
            self.customers_df["Customer Name"]
            !=
            self.customers_df["Customer Name"].str.strip()
        ).any()

        self.assertFalse(whitespace_found)

    def test_customer_names_standardised(self):

        title_case_check = (
            self.customers_df["Customer Name"]
            ==
            self.customers_df["Customer Name"].str.title()
        ).all()

        self.assertTrue(title_case_check)

    def test_no_duplicate_customer_ids(self):

        duplicates = self.customers_df.duplicated(
            subset=["Customer ID"]
        ).sum()

        self.assertEqual(duplicates, 0)

    def test_data_quality_report(self):

        print("\n")
        print("=" * 80)
        print("BOOKS DATA QUALITY REPORT")
        print("=" * 80)
    
        for issue in self.book_dq_before:
            print("\n")
            print("BOOKS BUSINESS RULE CHECKS")
            print("-" * 80)
            
            print(
                f"Invalid Checkout Dates Found: "
                f"{self.invalid_checkout_dates}"
            )
            
            print(
                f"Future Year Records Remaining: "
                f"{self.future_year_records}"
            )
            
            print(
                f"Returned Before Checkout: "
                f"{self.returned_before_checkout}"
            )
            
            print(
                f"Borrow Period Violations (>14 Days): "
                f"{self.borrow_period_violations}"
            )
            
            print(
                f"Negative Borrow Days: "
                f"{self.negative_borrow_days}"
            )
            
            print(
                f"Unknown Books Created: "
                f"{self.unknown_books}"
            )
            
            print(
                f"Customer IDs Replaced With -1: "
                f"{self.replaced_customer_ids}"
            )
    
            before = self.book_dq_before[issue]
            after = self.book_dq_after[issue]
    
            print(
                f"{issue}: "
                f"Before={before}, "
                f"After={after}, "
                f"Resolved={before-after}"
            )
    
        print("\n")
        print("=" * 80)
        print("CUSTOMERS DATA QUALITY REPORT")
        print("=" * 80)
    
        for issue in self.customer_dq_before:
    
            before = self.customer_dq_before[issue]
            after = self.customer_dq_after[issue]
    
            print(
                f"{issue}: "
                f"Before={before}, "
                f"After={after}, "
                f"Resolved={before-after}"
            )
    
        self.assertTrue(True)

        print("\n")
        print("CUSTOMER BUSINESS RULE CHECKS")
        print("-" * 80)
        
        print(
            f"Names Standardised: "
            f"{self.standardised_customer_names}"
        )
        
        print(
            f"Customer IDs Integer Datatype: "
            f"{self.integer_customer_ids}"
        )

if __name__ == "__main__":
    unittest.main()
